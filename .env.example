# Copy this file to .env.local and replace placeholder values locally.
# Never commit real credentials or .env.local.
DEMO_USER_ID=demo-user
DEMO_USERNAME=demo
DEMO_PASSWORD=replace-with-a-local-password
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_SECURE=false

DATABASE_URL=postgresql://mechat:replace-with-db-password@127.0.0.1:5432/mechat

DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding-flash

CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_COLLECTION=wiki_knowledge_v1
